# Hanedan Pilav, Plesk + LiteSpeed (Apache 2.4 uyumlu). Her yönerge IfModule korumalıdır.
# "BEGIN/END" blokları build sonrası (scripts/yayin-hazirla.ts) ortama göre doldurulur; elle düzenlemeyin.
# Staging'de doğrulanacak: bu dosya yerelde çalıştırılamaz (bkz. README, Yayın).

<IfModule mod_mime.c>
  AddDefaultCharset UTF-8
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html
  # "/yol" dizinine yönlendirme yapılmaz; sondaki eğik çizgisiz kanonik adres aşağıdaki yeniden yazımlarla sunulur.
  DirectorySlash Off
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Nokta dosyaları ve dizinleri kapalı (.well-known hariç: sertifika doğrulaması).
  RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,L]

  # Apex -> www (yalnız hanedanpilav.com; test alt alan adına dokunmaz). Tek adımda https'e de taşır.
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTP_HOST} ^hanedanpilav\.com$ [NC]
  RewriteRule ^ https://www.hanedanpilav.com%{REQUEST_URI} [R=301,L]

  # HTTPS zorlama (ters vekil arkasında X-Forwarded-Proto'ya da bakılır).
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Eski WordPress adresleri.
  RewriteRule ^about-us/?$ /kurumsal [R=301,L]
  RewriteRule ^contact/?$ /iletisim [R=301,L]
  RewriteRule ^menu/?$ /kurumsal#catering [R=301,L,NE]
  RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
  RewriteRule ^(?:hello-world(?:/.*)?|category(?:/.*)?|feed(?:/.*)?|wp-admin.*|wp-login\.php|wp-content/.*|wp-includes/.*|xmlrpc\.php)$ - [G,L]

  # Kaynak haritaları kapalı.
  RewriteRule \.map$ - [F,L]

  # Kanonik adres: /yol/index.html -> /yol, /yol/ -> /yol (301). Kök (/) etkilenmez.
  # Hedefler her zaman kendi host'una mutlak URL'dir; "//kotu.com/" gibi yollar açık yönlendirme üretemez.
  # Baştaki çoklu eğik çizgi önce sadeleştirilir.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s//+
  RewriteRule ^/*(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/(?:\S*/)?index\.html[\s?]
  RewriteRule ^(?:(.*)/)?index\.html$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteRule ^(.+?)/+$ https://%{HTTP_HOST}/$1 [R=301,L]

  # /yol -> /yol/index.html (iç yeniden yazım, adres çubuğu değişmez).
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# 404: TR için kökteki sayfa, /en altı için public/en/.htaccess'teki ErrorDocument (gerçek 404 koduyla).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
  # BEGIN ORTAM
  # END ORTAM
  # BEGIN CSP
  # END CSP
</IfModule>
ErrorDocument 404 /404/index.html

# Önbellek: hash'li Vite çıktısı (js, css, yazı tipleri) 1 yıl immutable, HTML her seferinde doğrulanır, görseller 7 gün.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml text/plain
</IfModule>

# Nokta dosyaları ve kaynak haritaları (rewrite modülü yoksa da) reddedilir.
<FilesMatch "^\.|\.map$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
