    "postbuild": "node scripts/sitemap.ts && node scripts/yayin-hazirla.ts",
    "check:yayin": "node scripts/check-yayin.ts",
    "typecheck": "react-router typegen && tsc --noEmit && node scripts/check-css-modulleri.ts",
    "check:metin": "node scripts/check-metin.ts",
    "check:rotalar": "node scripts/check-rotalar.ts",
    "serve": "node scripts/sunucu.ts build/client 8781",
    "test:e2e": "playwright test",
    "test:php": "PHP=8.2 npx -y @php-wasm/cli tests/php/form-test.php",
    "verify": "npm run typecheck && npm run check:metin && npm run test:unit && npm run build && npm run check:rotalar && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/rokkitt": "5.3.0",
