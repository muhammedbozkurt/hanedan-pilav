    "isbot": "5.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
